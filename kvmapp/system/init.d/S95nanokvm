#!/bin/sh
# nanokvm Rev3.1

case "$1" in
  start)
    echo -n kvm > /boot/hostname.prefix

    # Copy sensor config if the file exists
    [ -f /mnt/data/sensor_cfg.ini.LT ] && cp /mnt/data/sensor_cfg.ini.LT /mnt/data/sensor_cfg.ini

    # Generate unique device key
    if [ -f /sys/class/cvi-base/base_uid ]; then
        str_value=$(awk '{print $2}' /sys/class/cvi-base/base_uid)
        first_uint=$(echo "$str_value" | cut -d'_' -f1)
        second_uint=$(echo "$str_value" | cut -d'_' -f2)
        echo "$first_uint$second_uint" > /device_key
    fi

    # Set iptables rules (skip if already present).
    #
    # The web UI must be reachable on EVERY interface this device can be
    # addressed on. These rules were all scoped to -i/-o eth0, so on any image
    # whose INPUT policy is not ACCEPT the console answered over Ethernet and
    # nowhere else — not Wi-Fi, not the USB gadget. That is exactly the
    # "can't reach the web UI when only Wi-Fi is connected" report, and it is
    # invisible on a bench where Ethernet is always plugged in. S30wifi still
    # carries a commented-out `iptables --policy INPUT ACCEPT` + `-F` from
    # someone reaching for the blunt version of this fix.
    #
    # Dropping the interface match is a no-op under an ACCEPT policy and the
    # whole fix under DROP, so it is safe either way. Interface scoping is the
    # wrong control here regardless: which NIC a packet arrives on says nothing
    # about whether the console should answer it — authentication does.
    add_rule() {
        iptables -C "$@" 2>/dev/null || iptables -A "$@"
    }

    # HTTP and HTTPS in, and their replies out. 443 was never opened at all,
    # so a device configured with proto=https had no rule of its own.
    for port in 80 443; do
        add_rule INPUT -p tcp --dport "$port" -m state --state NEW,ESTABLISHED -j ACCEPT
        add_rule OUTPUT -p tcp --sport "$port" -m state --state ESTABLISHED -j ACCEPT
    done

    # Inbound SSH (S50sshd). The old pair matched --sport 22 on INPUT and
    # --dport 22 on OUTPUT, which is an SSH *client* on this box — the reply
    # direction of a connection it dialled out. Nothing admitted a connection
    # dialled IN, so under a DROP policy sshd was unreachable too. Both
    # directions are kept: the client rules are still wanted for outbound use.
    add_rule INPUT -p tcp --dport 22 -m state --state NEW,ESTABLISHED -j ACCEPT
    add_rule OUTPUT -p tcp --sport 22 -m state --state ESTABLISHED -j ACCEPT
    add_rule OUTPUT -p tcp --dport 22 -m state --state NEW,ESTABLISHED -j ACCEPT
    add_rule INPUT -p tcp --sport 22 -m state --state ESTABLISHED -j ACCEPT

    # Left eth0-scoped on purpose: this one DROPs, and widening a drop would
    # start blocking traffic that works today.
    add_rule OUTPUT -o eth0 -p tcp --sport 8000 -m state --state ESTABLISHED -j DROP

    # Logo selection
    if [ -f /boot/logo.ico ]; then
        if [ ! -f /kvmapp/server/web/original.ico ]; then
            mv /kvmapp/server/web/sipeed.ico /kvmapp/server/web/original.ico
            cp /boot/logo.ico /kvmapp/server/web/sipeed.ico
        fi
    else
        if [ -f /kvmapp/server/web/original.ico ]; then
            mv /kvmapp/server/web/original.ico /kvmapp/server/web/sipeed.ico
        fi
    fi

    # Start services
    cp -r /kvmapp/kvm_system /tmp/
    /tmp/kvm_system/kvm_system &

    cp -r /kvmapp/server /tmp/
    /tmp/server/NanoKVM-Server &
   ;;

  stop)
    killall kvm_system
    killall NanoKVM-Server
    rm -r /tmp/kvm_system /tmp/server
    echo "OK"
   ;;

  restart)
    killall kvm_system
    killall NanoKVM-Server
    rm -r /tmp/kvm_system /tmp/server

    cp -r /kvmapp/kvm_system /tmp/
    /tmp/kvm_system/kvm_system &

    cp -r /kvmapp/server /tmp/
    /tmp/server/NanoKVM-Server &

    sync
    echo "OK"
   ;;
    
  *)
    echo "Usage: $0 {start|stop|restart}"
    exit 1
  ;;
esac